# ============================================================================
# Environment Variables for Docker Compose Development Stack
# ============================================================================
# Copy this file to .env and customize as needed.
# Security: set strong values for all password/admin fields before use.
# ============================================================================

# PostgreSQL
POSTGRES_USER=kanokna
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=kanokna
POSTGRES_PORT=5432

# Kafka
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
SCHEMA_REGISTRY_PORT=8081
ZOOKEEPER_PORT=2181
KAFKA_UI_PORT=8090

# Redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_COMMANDER_PORT=8091

# Elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
KIBANA_PORT=5601

# Keycloak (Identity Provider)
KEYCLOAK_ADMIN=REPLACE_WITH_KEYCLOAK_ADMIN_USERNAME
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_STRONG_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_PORT=8180

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Monitoring Stack (--profile monitoring)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100
